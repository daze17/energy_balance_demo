# .env.example -> .env болгож хуулаад AI түлхүүрээ бөглөнө.
# .env файл git-д орохгүй (.gitignore).

# AI загвар: gemini (үнэгүй) эсвэл claude. Сольсны дараа: docker compose up -d
LLM_PROVIDER=gemini

# Google Gemini — үнэгүй түлхүүр: aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude (platform.claude.com, API credit шаардлагатай)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Админ самбарт нэвтрэх (локал)
ADMIN_EMAIL=admin@energybalance.local
ADMIN_PASSWORD=EnergyBalance2026

# Локал нууц утгууд — хүсвэл сольж болно
DB_PASSWORD=eb_local_pass
N8N_ENCRYPTION_KEY=change-me-local-only-key
SESSION_SECRET=local-dev-session-secret
INTERNAL_TOKEN=local-internal-token

# И-мэйл (Mailpit руу очно, бодитоор илгээгдэхгүй)
MAIL_FROM=info@energybalance.local
STAFF_EMAIL=manager@energybalance.local

# Жинхэнэ и-мэйл (үнэгүй): аль нэгний API key-г өгвөл Mailpit-ийн оронд түүгээр илгээнэ.
# MAIL_FROM нь тухайн үйлчилгээнд баталгаажсан sender байх ёстой.
# SMTP2GO: app.smtp2go.com → Sending → API Keys (1000/сар) · Brevo: SMTP & API → API keys (300/өдөр)
SMTP2GO_API_KEY=
BREVO_API_KEY=

# Бодит Facebook Page (заавал биш). Хоёуланг бөглөвөл батлагдсан пост Graph API-аар Page дээр нийтлэгдэнэ.
# developers.facebook.com → апп → Graph API Explorer → Page access token (pages_manage_posts, pages_read_engagement)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Facebook Messenger → чат агент (docs/MESSENGER.md). Webhook: https://<вэб хаяг>/webhooks/messenger
FB_VERIFY_TOKEN=
FB_PAGE_TOKEN=
FB_APP_SECRET=
