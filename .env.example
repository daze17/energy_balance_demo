# .env.example -> .env болгож хуулаад AI түлхүүрээ бөглөнө.
# .env файл git-д орохгүй (.gitignore).

# AI загвар: gemini (үнэгүй) эсвэл claude. Сольсны дараа: docker compose up -d
LLM_PROVIDER=gemini

# Google Gemini — үнэгүй түлхүүр: aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude (platform.claude.com, API credit шаардлагатай)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Админ самбарт нэвтрэх (локал)
ADMIN_EMAIL=admin@energybalance.local
ADMIN_PASSWORD=EnergyBalance2026

# Локал нууц утгууд — хүсвэл сольж болно
DB_PASSWORD=eb_local_pass
N8N_ENCRYPTION_KEY=change-me-local-only-key
SESSION_SECRET=local-dev-session-secret
INTERNAL_TOKEN=local-internal-token

# И-мэйл (Mailpit руу очно, бодитоор илгээгдэхгүй)
MAIL_FROM=info@energybalance.local
STAFF_EMAIL=manager@energybalance.local
