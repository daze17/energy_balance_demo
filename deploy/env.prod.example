# Сервер дээр: cp deploy/env.prod.example .env  → утгуудыг бөглөнө.
# Нууц утга үүсгэх: openssl rand -hex 24

# --- Домэйн (үнэгүй: <IP> -> 140-238-1-2 гэх мэт, sslip.io автоматаар IP руу заана) ---
SITE_DOMAIN=eb.140-238-1-2.sslip.io
N8N_DOMAIN=n8n.140-238-1-2.sslip.io
N8N_PUBLIC_URL=https://n8n.140-238-1-2.sslip.io
N8N_SECURE_COOKIE=true
MAILBOX_URL=https://mail.google.com
CHAT_ALLOWED_ORIGINS=https://eb.140-238-1-2.sslip.io

# --- Docker image (GitHub Actions ghcr.io руу түлхэнэ) ---
WEB_IMAGE=ghcr.io/daze17/energy-balance-web:latest

# --- AI ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Gmail SMTP (myaccount.google.com → 2-Step Verification → App passwords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_DISABLE_STARTTLS=false
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=
MAIL_FROM=your.address@gmail.com
STAFF_EMAIL=your.address@gmail.com

# --- Админ нэвтрэлт (хүчтэй нууц үг!) ---
ADMIN_EMAIL=admin@energybalance.mn
ADMIN_PASSWORD=

# --- Дотоод нууц утгууд (openssl rand -hex 24) ---
DB_PASSWORD=
N8N_ENCRYPTION_KEY=
SESSION_SECRET=
INTERNAL_TOKEN=

# Бодит Facebook Page (заавал биш). Хоёуланг бөглөвөл батлагдсан пост Graph API-аар Page дээр нийтлэгдэнэ.
# developers.facebook.com → апп → Graph API Explorer → Page access token (pages_manage_posts, pages_read_engagement)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
